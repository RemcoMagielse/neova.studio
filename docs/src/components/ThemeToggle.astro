---
// Replaces Starlight's ThemeSelect with a light/dark switch (Penpot › Website, row 12).
// Until the visitor clicks it, the theme follows the system. Starlight's ThemeProvider
// reads the same `starlight-theme` key on load, so a choice sticks without a flash.
---

<neova-theme-toggle>
	<button type="button" role="switch" aria-label="Dark theme" aria-checked="false">
		<span class="thumb" aria-hidden="true">
			<svg class="sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
			<svg class="moon" viewBox="0 0 24 24"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
		</span>
	</button>
</neova-theme-toggle>

<script>
	const storageKey = 'starlight-theme';
	const systemDark = matchMedia('(prefers-color-scheme: dark)');

	const stored = () => {
		try {
			const value = localStorage.getItem(storageKey);
			return value === 'light' || value === 'dark' ? value : null;
		} catch {
			return null;
		}
	};

	function apply(theme: 'light' | 'dark') {
		document.documentElement.dataset.theme = theme;
		document
			.querySelectorAll('neova-theme-toggle button')
			.forEach((button) => button.setAttribute('aria-checked', String(theme === 'dark')));
	}

	systemDark.addEventListener('change', (e) => {
		if (!stored()) apply(e.matches ? 'dark' : 'light');
	});

	class NeovaThemeToggle extends HTMLElement {
		constructor() {
			super();
			apply(stored() ?? (systemDark.matches ? 'dark' : 'light'));
			this.querySelector('button')?.addEventListener('click', () => {
				const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
				try {
					localStorage.setItem(storageKey, next);
				} catch {
					// Private mode: the choice lasts for this page only.
				}
				apply(next);
			});
		}
	}
	customElements.define('neova-theme-toggle', NeovaThemeToggle);
</script>

<style>
	button {
		position: relative;
		width: 4.5rem;
		height: 2rem;
		padding: 0;
		border: 0;
		border-radius: 99rem;
		background: var(--neova-toggle-track);
		cursor: pointer;
	}
	.thumb {
		position: absolute;
		top: 0.375rem;
		inset-inline-start: 0.375rem;
		width: 1.25rem;
		height: 1.25rem;
		border-radius: 99rem;
		background: var(--sl-color-accent);
		transition: transform 0.2s ease;
	}
	button[aria-checked='true'] .thumb {
		transform: translateX(2.5rem);
	}
	/* Sun or moon in the knob: the current theme at a glance (Penpot › Website, row 12). */
	.thumb svg {
		position: absolute;
		inset: 0.1875rem;
		fill: none;
		stroke: var(--neova-on-accent);
		stroke-width: 2.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.moon,
	button[aria-checked='true'] .sun {
		display: none;
	}
	button[aria-checked='true'] .moon {
		display: block;
	}
	button:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	@media (prefers-reduced-motion: reduce) {
		.thumb {
			transition: none;
		}
	}
</style>
