---
// Row 01 (Penpot › Website). The window tilts flat and grows while the hero is pinned.
import Window from '../../assets/landing/01-hero/window.light.svg';
---

<section class="section pin hero" aria-labelledby="hero-title">
	<div class="pin-sticky">
		<div class="stage">
			<div class="copy hero-copy">
				<p class="eyebrow">The workspace for AI coding agents</p>
				<h1 id="hero-title">Think. Build. Beyond.</h1>
				<p class="lede">
					Plan the work, hand it to a team of AI agents, and stay in control. One calm workspace for
					Claude Code, Codex and Gemini.
				</p>
				<div class="actions">
					<a class="button button-primary button-lg" href="#download" data-platform-label>Download for Mac</a>
					<a class="button button-secondary button-lg" href="/getting-started/introduction/">Read the docs</a>
				</div>
				<p class="fineprint">Free · macOS, Windows, Linux · Everything stays on your machine</p>
			</div>
			<div class="art hero-art">
				<div class="at panel window hero-window" style="--x:48;--y:96;--w:1344">
					<Window aria-label="The Neova Studio workspace: sidebar, task board and chat" role="img" />
				</div>
			</div>
		</div>
	</div>
</section>
